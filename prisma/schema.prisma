// Kanby — Prisma schema
// Self-hosted Kanban task manager.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Global role of a user.
enum GlobalRole {
  USER
  ADMIN
}

/// Whether a board is private to its owner or shared with a team.
enum BoardType {
  PERSONAL
  TEAM
}

/// Role of a member within a team board.
enum BoardRole {
  OWNER
  MEMBER
}

/// Period covered by a board that belongs to another board's calendar.
enum BoardPeriod {
  DAY
  WEEK
}

/// Semantic kind of a column. DONE drives the confetti celebration.
enum ColumnKind {
  TODO
  DOING
  DONE
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  displayName      String
  passwordHash     String
  avatarUrl        String?
  globalRole       GlobalRole @default(USER)
  /// If true, the user is forced to change their password on next visit.
  mustChangePwd    Boolean    @default(false)
  active           Boolean    @default(true)
  /// Stable Kosmy Board account id (OpenID Connect `sub`) linked to this user.
  /// Accounts are only ever matched on this value, never on the (unverified) email.
  kosmySub         String?    @unique
  /// Interface language ("fr" | "en"), used to localize notifications.
  locale           String?
  /// Restrictions set by an administrator (Kosmy Board users, kosmy.board-users.v1).
  /// They only apply to regular users (USER), never to administrators.
  /// Most boards the user may own; null = no limit, 0 = cannot create boards.
  maxBoards        Int?
  /// May use API tokens (mobile API, widget). Off: tokens are refused and none can be created.
  canUseApi        Boolean    @default(true)
  createdAt        DateTime   @default(now())

  ownedBoards      Board[]        @relation("BoardOwner")
  memberships      BoardMember[]
  assignedCards    Card[]         @relation("CardAssignee")
  comments         Comment[]
  apiTokens        ApiToken[]
  notifications    Notification[]
  triggeredNotifs  Notification[] @relation("NotificationActor")
  dateChanges      DateChange[]

  @@index([globalRole])
}

/// "Se connecter avec Kosmy Board" (OpenID Connect) settings. Single row (id = 1),
/// edited from the admin page. The client secret never leaves the server.
model KosmyBoardSettings {
  id           Int      @id @default(1)
  /// Issuer, e.g. https://board.example.com/oidc (no trailing slash).
  issuer       String
  clientId     String
  clientSecret String
  /// Create a Kanby account on first sign-in for an unknown Kosmy Board account.
  /// Off by default. Created accounts are never administrators.
  autoCreate   Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

/// Instance-wide settings edited from the admin page. Single row (id = 1).
model AppSettings {
  id                Int      @id @default(1)
  /// Public sign-up. null = follow the ALLOW_REGISTRATION env var.
  allowRegistration Boolean?
  updatedAt         DateTime @updatedAt
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  label      String
  /// SHA-256 hash of the raw token. Never store the raw token.
  tokenHash  String    @unique
  /// First 8 chars of the raw token, shown in the UI for identification.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model Board {
  id        String    @id @default(cuid())
  name      String
  type      BoardType
  owner     User      @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  /// Calendar: a board can hold one board per day and per week ("Elisa30 —
  /// Lundi 24 novembre 2026"). Those child boards point to their parent,
  /// share its owner, type and members, and are deleted with it.
  parent    Board?    @relation("BoardCalendar", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  children  Board[]   @relation("BoardCalendar")
  /// DAY or WEEK for a calendar board, null for a regular board.
  period    BoardPeriod?
  /// The day (DAY) or the Monday of the week (WEEK) the board covers.
  periodStart DateTime? @db.Date
  columns   Column[]
  labels    Label[]
  members   BoardMember[]
  cards     Card[]
  notifications Notification[]
  /// Date history of the board's calendar (only on the main board).
  dateChanges DateChange[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([parentId, period, periodStart])
  @@index([ownerId])
  @@index([type])
}

model BoardMember {
  id       String    @id @default(cuid())
  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId  String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     BoardRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model Column {
  id      String     @id @default(cuid())
  board   Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  name    String
  kind    ColumnKind @default(TODO)
  /// Sort index within the board.
  order   Int
  /// Optional color accent shown next to the column name.
  color   String?
  cards   Card[]

  @@index([boardId, order])
}

model Card {
  id          String     @id @default(cuid())
  column      Column     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String
  title       String
  description String?
  /// Optional due date — used by the widget summary.
  dueDate     DateTime?
  /// Importance: 0 = none, 1 = low, 2 = medium, 3 = high, 4 = urgent
  /// (shown as a small colored square).
  priority    Int        @default(0)
  /// Sort index within the column.
  order       Int
  assignee    User?      @relation("CardAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  labels      CardLabel[]
  checklist   ChecklistItem[]
  comments    Comment[]
  notifications Notification[]
  dateChanges DateChange[]
  /// Set when the card is moved into a DONE column.
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([boardId])
  @@index([columnId, order])
  @@index([dueDate])
  @@index([assigneeId])
}

model Label {
  id      String      @id @default(cuid())
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  name    String
  color   String
  cards   CardLabel[]

  @@index([boardId])
}

model CardLabel {
  card    Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId  String
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@id([cardId, labelId])
}

model ChecklistItem {
  id    String  @id @default(cuid())
  card  Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId String
  text  String
  done  Boolean @default(false)
  order Int

  @@index([cardId, order])
}

model Comment {
  id        String   @id @default(cuid())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}

/// Notification sent to a user about board activity (team boards only).
model Notification {
  id        String   @id @default(cuid())
  /// Recipient of the notification (never the actor).
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// User who performed the action (null for system-generated events).
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  /// Board the event happened on (null if the board was deleted).
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
  boardId   String?
  /// Card the event happened on (null if the card was deleted / not relevant).
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardId    String?
  /// Kind of event: card_assigned, card_updated, card_moved, card_commented,
  /// member_added, member_removed, board_updated.
  kind      String
  /// Short human-readable message (already localized for the recipient).
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([boardId])
}

enum DateChangeKind {
  CARD_MOVED
  BOARD_MOVED
  DUE_DATE
}

/// One change of date, kept for the history of a calendar:
///  - CARD_MOVED: a task transferred to another day (or week) of the calendar,
///  - BOARD_MOVED: a day / week board moved to another day / week,
///  - DUE_DATE: the due date of a task changed.
/// Kept when the task or board is deleted (title is a snapshot); deleted with
/// the main board.
model DateChange {
  id          String         @id @default(cuid())
  /// Main board of the calendar (the board itself for a regular board).
  rootBoard   Board          @relation(fields: [rootBoardId], references: [id], onDelete: Cascade)
  rootBoardId String
  kind        DateChangeKind
  /// DAY or WEEK for transfers and board moves, null for due dates.
  period      BoardPeriod?
  card        Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardId      String?
  /// Boards the change went from / to (ids only: they may be deleted later).
  fromBoardId String?
  toBoardId   String?
  /// Task title or board name at the time of the change.
  title       String
  /// Day before / after (null = no date: the main board, or no due date).
  fromDate    DateTime?      @db.Date
  toDate      DateTime?      @db.Date
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  createdAt   DateTime       @default(now())

  @@index([rootBoardId, createdAt])
  @@index([cardId, createdAt])
  @@index([fromBoardId])
  @@index([toBoardId])
}
