# Copiez ce fichier en `.env` et adaptez les valeurs avant de lancer
# `docker compose up -d`. (Sur Coolify, ce fichier n'est pas utilisé : voir README.)

# ----- Base de données PostgreSQL -----
POSTGRES_USER=kanby
POSTGRES_PASSWORD=changez-moi-aussi
POSTGRES_DB=kanby

# ----- Application -----
# Port exposé sur la machine hôte.
APP_PORT=3000
# URL publique de l'application. Mettez https://... derrière un proxy HTTPS :
# les cookies de session sont alors marqués « Secure ».
APP_URL=http://localhost:3000

# ----- Sécurité -----
# OBLIGATOIRE — secret de signature des sessions, 32 caractères minimum.
# Générez-le avec : openssl rand -hex 32
JWT_SECRET=
# Durée de vie des sessions en secondes (30 jours par défaut, 5 min à 1 an).
JWT_EXPIRES_IN=2592000

# ----- Compte administrateur créé au premier démarrage -----
AUTO_ADMIN_ON_BOOT=true
DEFAULT_ADMIN_EMAIL=admin@kanby.local
# Laissez vide : un mot de passe aléatoire est généré et affiché dans les logs
#   docker compose logs app | grep "Mot de passe"
# Dans tous les cas, il faudra le changer à la première connexion.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrateur

# ----- Inscriptions -----
# true = tout le monde peut créer un compte ; false = seul l'admin crée les comptes.
ALLOW_REGISTRATION=true
# (Optionnel) Si vrai et qu'aucun utilisateur n'existe, le premier inscrit
# devient admin. Utile en développement sans admin par défaut.
AUTO_ADMIN_FIRST=false
